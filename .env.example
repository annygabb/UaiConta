# Frontend — use apenas a chave pública/publishable do projeto.
# Nunca exponha SUPABASE_SERVICE_ROLE_KEY no Vite/browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Compatibilidade temporária com projetos que ainda usam a chave anon legada.
# VITE_SUPABASE_ANON_KEY=

# Modo demo precisa ser explicitamente ativado em desenvolvimento.
VITE_ENABLE_DEMO_MODE=false
